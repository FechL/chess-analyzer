# npm run dev creates .env with a random password when it does not exist.
POSTGRES_DB=kuda
POSTGRES_USER=kuda
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432
API_HOST=127.0.0.1
API_PORT=3001
DEV_PORT=5173
# Comma-separated browser origins allowed to change account data.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set true when serving the application through HTTPS.
COOKIE_SECURE=false
